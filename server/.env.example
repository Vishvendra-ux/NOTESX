PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/notesx
NODE_ENV=development
# Generate a cryptographically strong 64-char key in terminal: openssl rand -hex 32
JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters
CLIENT_URL=http://localhost:5173
# Optional: Google OAuth Client ID for verifying Google Sign-In tokens
GOOGLE_CLIENT_ID=
# Optional: Admin bootstrap on initialization (will not overwrite existing records)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional: Judge0 Remote Execution Engine (RapidAPI or Self-Hosted Docker)
# Leave blank to use high-performance local sandboxed execution
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# Optional: Google Gemini AI API (@google/genai) for 24/7 AI Tutor
# Leave blank to use local document-grounded knowledge base
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

